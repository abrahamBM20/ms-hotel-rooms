# ===========================================================================
#  MANIFIESTO DE VARIABLES DE ENTORNO DEL STACK HOTEL BOUTIQUE 360
# ===========================================================================
#
#  Este archivo es la referencia ÚNICA de qué variables existen, quién las usa y
#  qué valor deben tener. Los valores del frontend (.env) son los canónicos:
#  si algo cambia ahí (pool de Cognito, API Gateway), se cambia aquí primero.
#
#  USO EN LOCAL
#    Copiar este archivo a `secrets.env` (queda en .gitignore) y cargarlo:
#
#      # bash / git-bash
#      cp config/secrets.env.example config/secrets.env
#      set -a && . config/secrets.env && set +a
#
#      # PowerShell
#      Copy-Item config/secrets.env.example config/secrets.env
#      Get-Content config/secrets.env | Where-Object { $_ -match '=' -and $_ -notmatch '^#' } |
#        ForEach-Object { $n,$v = $_ -split '=',2; Set-Item -Path "Env:$n" -Value $v }
#
#    OJO: `PORT` NO está en este archivo a propósito. Cada proceso se levanta
#    con su propio puerto:
#      PORT=8080 ./gradlew bootRun     # BFF
#      PORT=8081 ./gradlew bootRun     # ms-hotel-rooms
#
#  USO EN AWS
#    El valor real NO se commitea. Va en tres sitios (y debe ser el MISMO):
#      1. Stage variable del API Gateway  -> la inyecta como cabecera X-Secret-Gateway
#      2. Env var del contenedor/EC2 del BFF           -> API_GATEWAY_SECRET
#      3. Env var del contenedor/EC2 de ms-hotel-rooms -> API_GATEWAY_SECRET
#    Y en GitHub Actions, como secret `API_GATEWAY_SECRET`, para los pipelines.
#
#  REGLA DE ORO
#    Si API_GATEWAY_SECRET no coincide en los tres sitios, la cadena devuelve 403.
#    ms-hotel-rooms NO se expone a internet: solo el BFF llega a el. Esa es la
#    capa de seguridad principal; el secreto compartido es la capa añadida.
# ===========================================================================


# ---------------------------------------------------------------------------
#  COMPARTIDAS POR TODO EL STACK
#  Tienen que ser idénticas en el BFF, en ms-hotel-rooms y en las Lambdas.
# ---------------------------------------------------------------------------

# Pool de Cognito que valida los JWT. Mismo que VITE_COGNITO_AUTHORITY del front.
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_rf0QM9OSc

# Secreto del API Gateway. OBLIGATORIO en los dos Spring y en la Lambda de lectura.
# Sin esta variable ms-hotel-rooms y el BFF NO arrancan.
API_GATEWAY_SECRET=cambiar_este_secreto

# Host publico (informativo; lo usa el health check para armar URLs).
PUBLIC_HOST_URL=https://evyja84d54.execute-api.us-east-1.amazonaws.com

# PostgreSQL. El BFF y ms-hotel-rooms usan el formato JDBC; las Lambdas, el de
# la libreria pg (ver la seccion LAMBDAS).
DB_URL=jdbc:postgresql://localhost:5432/hotel
DB_USER=postgres
DB_PASSWORD=postgres


# ---------------------------------------------------------------------------
#  FRONTEND  (frontend-hotelboutique360/.env)
# ---------------------------------------------------------------------------

# Pool de Cognito + app SPA. Deben coincidir con COGNITO_ISSUER_URI.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_rf0QM9OSc
VITE_COGNITO_CLIENT_ID=6kedlgs87lqop67oboc65h7lh7

# API Gateway que expone el BFF.
VITE_API_URL=https://evyja84d54.execute-api.us-east-1.amazonaws.com
VITE_API_BASE=https://evyja84d54.execute-api.us-east-1.amazonaws.com


# ---------------------------------------------------------------------------
#  BFF  (cloud-hotel-bff)
# ---------------------------------------------------------------------------

# Topic SNS donde el BFF publica las solicitudes de reserva.
SNS_RESERVATION_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:hotel-reservation-events

# Region de AWS (SNS).
AWS_REGION=us-east-1

# Function URL de la Lambda 'reservation-query' (la que resuelve las lecturas).
RESERVATIONS_LAMBDA_URL=https://xxxxxxxxxxxx.lambda-url.us-east-1.on.aws/

# URL del microservicio de habitaciones. En AWS: la red interna, no la publica.
ROOMS_SERVICE_URL=http://localhost:8081

# Secreto que el BFF envía a ms-hotel-rooms. Si no se define usa API_GATEWAY_SECRET.
# Para mas aislamiento se puede poner un valor DISTINTO (ver config/README.md).
# ROOMS_GATEWAY_SECRET=cambiar_este_secreto


# ---------------------------------------------------------------------------
#  LAMBDAS  (cloud-hotel-lambda/*)
#  Las Lambdas NO usan el secreto de la pasarela: solo el BFF y ms-hotel-rooms.
# ---------------------------------------------------------------------------

# Connection string de Postgres (formato de la libreria pg, NO JDBC).
# OBLIGATORIA en las tres. En Supabase: el del POOLER (puerto 6543), ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel

# 'false' solo para Postgres local sin SSL. En Supabase se deja sin definir.
DATABASE_SSL=false

# API de avisos del hotel (opcional). Sin esto, NOTIFY_MODE=log.
# API_NOTIFICATION=https://mi-app.example.com
# API_TOKEN_INTEGRATION=crr_xxxxxxxx

# 'log' imprime el aviso en vez de publicarlo. Para produccion: quitarlo.
NOTIFY_MODE=log
